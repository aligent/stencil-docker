#!/bin/bash
# Docker Hub build hook
# Builds images for the last 2 major versions of stencil-cli
# Creates tags: major (8), minor (8.10), patch (8.10.5), and latest

set -e

declare -A MAJOR_VERSIONS

echo "Fetching stencil-cli versions from npm..."
NPM_VERSIONS=$(npm view @bigcommerce/stencil-cli versions --json 2>/dev/null)

# First pass: find the highest major version
HIGHEST_MAJOR=0
for version in $(echo "$NPM_VERSIONS" | jq -r '.[]'); do
    # Skip pre-release versions
    if [[ "$version" == *"-"* ]]; then
        continue
    fi
    MAJOR=$(echo "$version" | cut -d. -f1)
    if [ "$MAJOR" -gt "$HIGHEST_MAJOR" ]; then
        HIGHEST_MAJOR="$MAJOR"
    fi
done

# Build last 2 major versions
MIN_MAJOR=$((HIGHEST_MAJOR - 1))
echo "Building last 2 major versions (${MIN_MAJOR} and ${HIGHEST_MAJOR})"

# Second pass: find highest version for each major
for version in $(echo "$NPM_VERSIONS" | jq -r '.[]'); do
    # Skip pre-release versions
    if [[ "$version" == *"-"* ]]; then
        continue
    fi

    MAJOR=$(echo "$version" | cut -d. -f1)

    # Skip versions below minimum
    if [ "$MAJOR" -lt "$MIN_MAJOR" ]; then
        continue
    fi

    # Update if this is higher than current for this major
    if [ -z "${MAJOR_VERSIONS[$MAJOR]}" ]; then
        MAJOR_VERSIONS[$MAJOR]="$version"
    else
        CURRENT="${MAJOR_VERSIONS[$MAJOR]}"
        if [ "$(printf '%s\n' "$CURRENT" "$version" | sort -V | tail -n1)" = "$version" ]; then
            MAJOR_VERSIONS[$MAJOR]="$version"
        fi
    fi
done

# Build each major's latest version
LATEST_VERSION=""
for MAJOR in $(echo "${!MAJOR_VERSIONS[@]}" | tr ' ' '\n' | sort -n); do
    version="${MAJOR_VERSIONS[$MAJOR]}"
    MINOR=$(echo "$version" | cut -d. -f1-2)
    LATEST_VERSION="$version"

    echo "============================================"
    echo "Building stencil-cli ${version}"
    echo "  Tags: ${version}, ${MINOR}, ${MAJOR}"
    echo "============================================"

    docker build \
        --build-arg STENCIL_VERSION="$version" \
        -f "$DOCKERFILE_PATH" \
        -t "${DOCKER_REPO}:${version}" \
        -t "${DOCKER_REPO}:${MINOR}" \
        -t "${DOCKER_REPO}:${MAJOR}" \
        .
done

# Tag latest
if [ -n "$LATEST_VERSION" ]; then
    echo "============================================"
    echo "Tagging ${LATEST_VERSION} as latest"
    echo "============================================"
    docker tag "${DOCKER_REPO}:${LATEST_VERSION}" "${DOCKER_REPO}:latest"
fi
